# Public Convex Cloud URL for the production build (baked into the client bundle).
#
# JANGAN PERNAH menaruh deploy key di berkas ini. Berkas ini ter-track git dan
# repo ini PUBLIK. Deploy key masuk lewat build arg CONVEX_DEPLOY_KEY di Dokploy
# saja — dan awalan NEXT_PUBLIC_ membuat Next.js meng-inline nilainya ke bundel
# browser, jadi awalan itu justru kebalikan dari yang diinginkan untuk rahasia.
# Not a secret — it ships to every browser. Local dev uses the dev deployment in
# .env.local (gitignored). Backend: template-projects / interior / production.
NEXT_PUBLIC_CONVEX_URL=https://veracious-rooster-179.convex.cloud
